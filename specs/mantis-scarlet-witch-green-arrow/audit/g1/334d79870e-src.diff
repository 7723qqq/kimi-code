-  await mkdir(root, { recursive: true });
-  const dir = await mkdtemp(join(root, 'upload-'));
-  return join(dir, filename);
-}
-
-function archivePathCleanupDir(archivePath: string): string {
-  return dirname(archivePath);
-}
