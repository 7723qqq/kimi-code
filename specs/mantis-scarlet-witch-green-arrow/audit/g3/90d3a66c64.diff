+      ctrlEnterRecognized,
+      onSelect: vi.fn(),
+      onCancel: vi.fn(),
+    });
+
+    const lines = picker.render(140).map((line) => strip(line).trim());
+
+    expect(lines).toContain(queue);
+    expect(lines).toContain(steer);
+  });
+});
