{
  "name": "@moonshot-ai/pi-tui",
  "version": "0.84.4",
  "private": true,
  "description": "Terminal User Interface library with differential rendering for efficient text-based applications",
  "keywords": [
    "cli",
    "differential-rendering",
    "terminal",
    "text-editor",
    "tui",
    "typescript",
    "ui"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/pi-tui#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/pi-tui"
  },
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun scripts/test.mjs",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@xterm/headless": "5.5.0",
    "chalk": "^5.4.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
