{
  "name": "@moonshot-ai/kimi-code-oauth",
  "version": "0.4.1",
  "private": true,
  "description": "Kimi OAuth toolkit for managed Kimi Code authentication",
  "keywords": [
    "auth",
    "authentication",
    "cli",
    "kimi",
    "oauth"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/oauth#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/oauth"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./device": {
      "types": "./src/device.ts",
      "default": "./src/device.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@moonshot-ai/kosong": "workspace:*",
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
