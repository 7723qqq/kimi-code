{
  "name": "@moonshot-ai/kap-server",
  "version": "0.2.3",
  "private": true,
  "description": "Kimi Code server (REST + WebSocket). The v2 engine dependency is retired: engine services are stubbed behind src/compat and the real serving surface is the native Rust server in packages/kimi-agent.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./search-worker-runtime": {
      "types": "./src/search/worker/runtime.ts",
      "default": "./src/search/worker/runtime.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "imports": {
    "#/compat/*.js": "./src/compat/*.ts",
    "#/compat/*": "./src/compat/*.ts",
    "#/*.js": "./src/*.ts",
    "#/*": "./src/*.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-i18n": "workspace:^",
    "@moonshot-ai/minidb": "workspace:*",
    "@moonshot-ai/transcript": "workspace:^",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "ulid": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0"
  }
}
