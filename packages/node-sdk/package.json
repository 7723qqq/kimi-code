{
  "name": "@moonshot-ai/kimi-code-sdk",
  "version": "0.19.2",
  "private": true,
  "description": "TypeScript SDK for the Kimi Code Agent. M3-marked v2 library consumer — see packages/agent-core-v2/AGENTS.md §Library surface. Re-exports v2 wire types (Event2 / ContextMessage / CompactionResult / AgentReplayRecord / file + mcp + capability types) and v2 runtime helpers (proxy dispatcher / token estimation / log path resolution); the v2 RPC client uses IEngineOverrideService for in-memory v2 process talks. Stays on v2 until M5 deletion; new embedders default to the Rust engine in packages/kimi-agent.",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "keywords": [
    "kimi",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/legacy": "./src/legacy/index.ts",
    "#/legacy/*": "./src/legacy/*.ts",
    "#/config-local": "./src/config-local/index.ts",
    "#/config-local/*": "./src/config-local/*.ts",
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && bun run build:dts",
    "build:dts": "bun scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "smol-toml": "^1.6.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kaos": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-i18n": "workspace:^",
    "@moonshot-ai/klient": "workspace:^",
    "@moonshot-ai/kosong": "workspace:^",
    "@moonshot-ai/protocol": "workspace:^",
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  }
}
