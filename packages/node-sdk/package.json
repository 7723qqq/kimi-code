{
  "name": "@moonshot-ai/kimi-code-sdk",
  "version": "0.20.0",
  "private": true,
  "description": "TypeScript SDK for the Kimi Code Agent. Fully decoupled from @moonshot-ai/agent-core-v2 (the v2 engine is retired); the public surface keeps the v2 wire shapes as frozen local types and the shared wire/MCP-OAuth contract lives in @moonshot-ai/protocol. The RPC client talks to the Rust engine (packages/kimi-agent) through the native addon or stdio.",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "keywords": [
    "kimi",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/error-protocol": "./src/error-protocol/index.ts",
    "#/error-protocol/*": "./src/error-protocol/*.ts",
    "#/logging": "./src/logging.ts",
    "#/telemetry": "./src/telemetry.ts",
    "#/config-helpers": "./src/config-helpers.ts",
    "#/model-alias": "./src/model-alias.ts",
    "#/config-local": "./src/config-local/index.ts",
    "#/config-local/*": "./src/config-local/*.ts",
    "#/media": "./src/media/index.ts",
    "#/media/*": "./src/media/*.ts",
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && bun run build:dts",
    "build:dts": "bun scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "socks": "^2.8.9",
    "smol-toml": "^1.6.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@moonshot-ai/kaos": "workspace:^",
    "@moonshot-ai/kimi-agent": "workspace:*",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-i18n": "workspace:^",
    "@moonshot-ai/kosong": "workspace:^",
    "@moonshot-ai/protocol": "workspace:^",
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  }
}
