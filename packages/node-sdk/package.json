{
  "name": "@moonshot-ai/kimi-code-sdk",
  "version": "0.21.1",
  "private": true,
  "description": "TypeScript SDK for the Kimi Code Agent",
  "keywords": [
    "agent",
    "api",
    "kimi",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/node-sdk#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/node-sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    },
    "./config-mapper": {
      "types": "./src/v2/config-mapper.ts",
      "default": "./src/v2/config-mapper.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./errors-codes": {
      "types": "./src/errors-codes.ts",
      "default": "./src/errors-codes.ts"
    },
    "./logging": {
      "types": "./src/logging/index.ts",
      "default": "./src/logging/index.ts"
    },
    "./proxy": {
      "types": "./src/proxy.ts",
      "default": "./src/proxy.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && bun run build:dts",
    "build:dts": "bun scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "KIMI_LOG_LEVEL=off bun ../../scripts/run-package-tests.mjs --root=test --test-timeout=15000",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@moonshot-ai/runtime-shared": "workspace:^",
    "smol-toml": "catalog:",
    "yazl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-code-product": "workspace:^",
    "@moonshot-ai/kimi-i18n": "workspace:^",
    "@moonshot-ai/klient": "workspace:^",
    "@moonshot-ai/kosong": "workspace:^",
    "@types/yazl": "^2.4.6"
  }
}
