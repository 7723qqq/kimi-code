{
  "name": "@moonshot-ai/kimi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Rust agent engine for Kimi Code",
  "type": "module",
  "exports": {
    ".": "./rust-loop.ts",
    "./native": {
      "types": "./index.native.d.ts",
      "default": "./index.native.js"
    },
    "./rust-loop": {
      "types": "./rust-loop.ts",
      "default": "./rust-loop.ts"
    },
    "./session-handle": {
      "types": "./session-handle.ts",
      "default": "./session-handle.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --release --dts target/napi-generated.d.ts && bun scripts/fix-napi-dts.mjs",
    "test": "cargo test --features cli",
  "test:js": "vitest run"
  },
  "napi": {
    "binaryName": "kimi_agent",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
