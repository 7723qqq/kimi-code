{
  "name": "@moonshot-ai/kimi-i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Shared i18n infrastructure for Kimi Code — locale-aware t() with en/zh support",
  "keywords": [
    "i18n",
    "internationalization",
    "kimi",
    "locale"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/i18n"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@moonshot-ai/i18n-shared": "workspace:^",
    "@moonshot-ai/kimi-native-tools": "workspace:^"
  }
}
