{
  "name": "@moonshot-ai/kosong",
  "version": "0.5.5",
  "private": true,
  "description": "The LLM abstraction layer for modern AI agent applications",
  "keywords": [
    "agent",
    "ai",
    "llm",
    "provider"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/kosong#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/kosong"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    },
    "./errors/*": {
      "types": "./src/errors/*.ts",
      "default": "./src/errors/*.ts"
    },
    "./message": {
      "types": "./src/message.ts",
      "default": "./src/message.ts"
    },
    "./message-helpers": {
      "types": "./src/message-helpers.ts",
      "default": "./src/message-helpers.ts"
    },
    "./tool": {
      "types": "./src/tool.ts",
      "default": "./src/tool.ts"
    },
    "./usage": {
      "types": "./src/usage.ts",
      "default": "./src/usage.ts"
    },
    "./capability": {
      "types": "./src/capability.ts",
      "default": "./src/capability.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "default": "./src/provider.ts"
    },
    "./generate": {
      "types": "./src/generate.ts",
      "default": "./src/generate.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./inspection": {
      "types": "./src/inspection.ts",
      "default": "./src/inspection.ts"
    },
    "./request-trace": {
      "types": "./src/request-trace.ts",
      "default": "./src/request-trace.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.49.0",
    "@moonshot-ai/kimi-i18n": "workspace:^",
    "@moonshot-ai/kimi-native-tools": "workspace:^",
    "openai": "^6.34.0",
    "undici": "^8.5.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  }
}
