{
  "name": "@moonshot-ai/agent-core-v2",
  "version": "0.4.2",
  "private": true,
  "description": "The unified agent engine for Kimi (v2 — DI Scope architecture)",
  "keywords": [
    "agent",
    "ai",
    "kimi",
    "llm",
    "session",
    "tools"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/agent-core-v2#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/agent-core-v2"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:contract-types": "bun scripts/gen-contract-types.mjs",
    "gen:config-manifest": "bun scripts/gen-config-manifest.mts",
    "gen:wire-manifest": "bun scripts/gen-wire-manifest.mts",
    "gen:state-manifest": "bun scripts/gen-state-manifest.mts",
    "lint:imports": "bun scripts/check-import-boundaries.mjs",
    "check:engine-zero-js-loop": "bun scripts/check-engine-zero-js-loop.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.49.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/minidb": "workspace:^",
    "@moonshot-ai/protocol": "workspace:^",
    "@moonshot-ai/tree-sitter-bash": "workspace:^",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "ignore": "^5.3.2",
    "immer": "^11.1.0",
    "jimp": "^1.6.1",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "openai": "^6.34.0",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "retry": "0.13.1",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "socks": "^2.8.9",
    "tar": "^7.5.13",
    "ulid": "^3.0.1",
    "undici": "^8.5.0",
    "xstate": "^5.32.5",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "@types/retry": "0.12.0",
    "@types/semver": "^7.7.0",
    "@types/sinon": "^21.0.1",
    "@types/tar": "^7.0.87",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "sinon": "^22.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0"
  }
}
