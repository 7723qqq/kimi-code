{
  "name": "@moonshot-ai/minidb",
  "version": "0.2.0",
  "private": true,
  "description": "A pure-Node.js embedded key-value database mixing Redis-style in-memory KV with SQLite-style durable persistence (WAL + snapshot).",
  "keywords": [
    "database",
    "embedded",
    "key-value",
    "kimi",
    "snapshot",
    "wal"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/minidb#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/minidb"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cluster": {
      "types": "./src/cluster/index.ts",
      "default": "./src/cluster/index.ts"
    },
    "./worker-runtime": {
      "types": "./src/worker-runtime.ts",
      "default": "./src/worker-runtime.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "bun bench/bench.ts",
    "bench:cluster": "bun bench/cluster.ts",
    "bench:open": "bun bench/open-lifecycle.ts",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  }
}
