{
  "name": "@moonshot-ai/migration-legacy",
  "version": "0.1.16",
  "private": true,
  "description": "Migrate kimi-cli (~/.kimi/) data into kimi-code (~/.kimi-code/).",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/protocol": "workspace:^",
    "pathe": "^2.0.3",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@moonshot-ai/transcript": "workspace:^"
  }
}
