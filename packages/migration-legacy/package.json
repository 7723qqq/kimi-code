{
  "name": "@moonshot-ai/migration-legacy",
  "version": "0.1.17",
  "description": "Migrate kimi-cli (~/.kimi/) data into kimi-code (~/.kimi-code/).",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/run-package-tests.mjs --root=test",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "smol-toml": "catalog:",
    "zod": "catalog:"
  }
}
