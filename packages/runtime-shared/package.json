{
  "name": "@moonshot-ai/runtime-shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime helpers — value guards and error formatting used across the packages and apps",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./guards": {
      "types": "./src/guards.ts",
      "default": "./src/guards.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./fetch": {
      "types": "./src/fetch.ts",
      "default": "./src/fetch.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/run-package-tests.mjs --root=test"
  }
}
