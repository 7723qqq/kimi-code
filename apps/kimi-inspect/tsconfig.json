{
  // Mirror the repo root tsconfig: agent-core-v2 is consumed through source
  // `exports`, so its sources are type-checked here too, and the strictness
  // flags must match the root exactly. The src includes are required (not
  // just for speed): agent-core-v2 fills interfaces like `AgentTaskInfoByKind`
  // via cross-module `declare module` augmentation, and those collapse to
  // `never` when the augmenting files are not in the program. Only the
  // environment (DOM + vite client types) differs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The inherited `typeRoots` are relative to the repo-root tsconfig, so they
    // point outside this package's `types` lookup once `vite/client` (a plain
    // node package, not an `@types` entry) has to be resolved. Root the lookup at
    // the workspace `node_modules` as well, and keep the inherited `bun-test`
    // so `bun:test` stays typed in the co-located suites.
    "typeRoots": ["../../node_modules/@types", "../../types", "../../node_modules"],
    "types": ["node", "bun-test", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts",
    "../../packages/agent-core-v2/src"
  ],
  "exclude": ["../../packages/agent-core-v2/src/human"]
}
