{
  // Mirror the repo root tsconfig so the strictness flags match exactly;
  // only the environment (DOM + vite client types) differs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["src", "vite", "vite.config.ts"]
}
