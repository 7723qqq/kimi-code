{
  "name": "@moonshot-ai/kimi-code",
  "version": "0.39.0",
  "description": "The Starting Point for Next-Gen Agents",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "coding-agent",
    "kimi",
    "kimi-code",
    "tui"
  ],
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/apps/kimi-code#readme",
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "apps/kimi-code"
  },
  "bin": {
    "kimi": "dist/main.mjs"
  },
  "files": [
    "dist",
    "dist-web",
    "native",
    "scripts/postinstall.mjs",
    "scripts/postinstall",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/i18n": "./src/i18n/index.ts",
    "#/tui/theme": "./src/tui/theme/index.ts",
    "#/tui/commands": "./src/tui/commands/index.ts",
    "#/cli/sub/web": "./src/cli/sub/web/index.ts",
    "#/cli/sub/web/*": "./src/cli/sub/web/*.ts",
    "#/generated/vis-web-asset": [
      "./src/generated/vis-web-asset.ts",
      "./src/generated/vis-web-asset.d.ts"
    ],
    "#/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.dist-worker.config.ts && bun scripts/copy-native-assets.mjs && bun scripts/check-web-assets.mjs",
    "prebuild": "bun scripts/build-vis-asset.mjs",
    "catalog:update": "bun scripts/update-catalog.mjs --out dist/built-in-catalog.json",
    "smoke": "bun scripts/smoke.mjs",
    "build:native:js": "bun scripts/native/01-bundle.mjs",
    "build:native:bun": "bun scripts/native/build-bun.mjs",
    "build:native:bun:release": "bun scripts/native/build-bun.mjs --profile=release",
    "package:native": "bun scripts/native/package.mjs",
    "produce:native:manifest": "bun scripts/native/produce-manifest.mjs",
    "release:native:resolve": "bun scripts/native/resolve-release.mjs",
    "test:native:smoke": "bun scripts/native/smoke.mjs",
    "dev": "bun scripts/dev.mjs",
    "dev:cli-only": "bun --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:server": "KIMI_CODE_DEV_SERVER=1 bun --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server": "KIMI_CODE_DEV_SERVER=1 bun --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server:multi": "KIMI_CODE_DEV_SERVER=1 bun --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:server:restart": "bun scripts/dev-server-restart.mjs",
    "dev:plugin-marketplace": "bun scripts/dev-plugin-marketplace-server.mjs",
    "build:plugin-marketplace": "bun scripts/build-plugin-marketplace-cdn.mjs",
    "dev:prod": "bun dist/main.mjs",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && bun run build:packages && bun --bun run vitest run",
    "e2e": "cd ../.. && bun run build:packages && KIMI_E2E=1 bun --bun run vitest run test/e2e",
    "e2e:real": "cd ../.. && bun run build:packages && KIMI_E2E_REAL=1 bun --bun run vitest run test/e2e/real-llm-smoke.e2e.test.ts",
    "postinstall": "bun scripts/postinstall.mjs"
  },
  "dependencies": {
    "@moonshot-ai/kimi-agent": "workspace:^",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@moonshot-ai/acp-server": "workspace:^",
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/i18n-shared": "workspace:^",
    "@moonshot-ai/kap-server": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/kimi-telemetry": "workspace:^",
    "@moonshot-ai/migration-legacy": "workspace:^",
    "@moonshot-ai/minidb": "workspace:^",
    "@moonshot-ai/pi-tui": "workspace:^",
    "@moonshot-ai/vis-server": "workspace:^",
    "@moonshot-ai/vis-web": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.0",
    "@types/yazl": "^2.4.6",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "jimp": "^1.6.1",
    "pathe": "^2.0.3",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tsx": "^4.21.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9",
    "@moonshot-ai/kimi-native-tools": "workspace:^",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
