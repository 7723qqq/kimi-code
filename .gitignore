/kimi-debug-ses_*.zip

# Secrets and logs - never commit
.env*
!.env.example
*.log
logs/

# Legacy pnpm artifacts; Bun is the package manager. pnpm auto-installs
# may recreate these locally — never commit them.
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Zig build output for the structural review tool (tools/review).
tools/review/zig-out/
tools/review/.zig-cache/
