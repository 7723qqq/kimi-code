{
  "name": "@moonshot-ai/monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "apps/vis/server",
      "apps/vis/web",
      "docs",
      "tests/scenarios",
      "scripts/icon-tools"
    ],
    "catalog": {
      "zod": "4.3.6",
      "pathe": "^2.0.3",
      "smol-toml": "^1.6.1",
      "jimp": "^1.6.1",
      "yazl": "^3.3.1",
      "ulid": "^3.0.1",
      "ws": "^8.18.0"
    }
  },
  "type": "module",
  "scripts": {
    "bench:prompt": "bun scripts/prompt-optimizer/src/cli.ts bench",
    "bench:prompt:4521": "bun scripts/prompt-optimizer/src/measure-4521.ts",
    "bench:prompt:compare": "bun scripts/prompt-optimizer/src/cli.ts bench --compare",
    "bench:prompt:probe": "bun scripts/prompt-optimizer/src/cli.ts probe",
    "bench:prompt:prune": "bun scripts/prompt-optimizer/src/cli.ts prune",
    "build": "bun run --workspaces --if-present build",
    "build:docs": "cd docs && bun run build",
    "build:icons": "node scripts/icon-tools/build-brand-icons.mjs",
    "build:packages": "bun run --filter './packages/*' build",
    "build:plugin-marketplace": "cd apps/kimi-code && bun run build:plugin-marketplace",
    "build:web": "bun run --filter kimi-code-app build:web",
    "changeset": "changeset",
    "check:boundaries": "cd packages/agent-core-v2 && bun run lint:imports",
    "check:catalog-versions": "bun tools/review/check-catalog-versions.mjs",
    "check:deep-imports": "bun packages/agent-core-v2/scripts/check-deep-imports.mjs",
    "check:git-memory": "bun packages/agent-core-v2/scripts/check-git-memory-injection.mjs",
    "check:lint": "bun run lint && bun run sherif && bun run check:deep-imports && bun run check:boundaries && bun run check:no-comments && bun run check:git-memory && bun run scan:residue && bun run check:locale-keys && bun run check:locale-placeholders && bun run check:t-coverage && bun run check:status-surface-i18n && bun run check:no-hardcoded-prose && bun run check:strict-request-bodies && bun run check:catalog-versions && bun run check:service-naming",
    "check:locale-keys": "bun scripts/check-locale-keys.mjs",
    "check:locale-placeholders": "bun scripts/check-locale-placeholders.cjs",
    "check:nix-workspace": "bun scripts/check-nix-workspace.mjs",
    "check:no-comments": "bun scripts/check-no-comments.mjs",
    "check:no-comments:counts": "bun scripts/check-no-comments.mjs --print-counts",
    "check:no-hardcoded-prose": "bun scripts/check-no-hardcoded-prose.mjs",
    "check:no-hardcoded-prose:counts": "bun scripts/check-no-hardcoded-prose.mjs --print-counts",
    "check:prompt-ownership": "bun scripts/check-prompt-ownership.mjs",
    "check:service-naming": "bun scripts/check-service-naming.mjs",
    "check:status-surface-i18n": "bun scripts/check-status-surface-i18n.mjs",
    "check:strict-request-bodies": "bun tools/review/check-strict-request-bodies.mjs",
    "check:t-coverage": "bun scripts/check-t-call-coverage.mjs",
    "clean": "bun run --workspaces --if-present clean",
    "dev:cli": "cd apps/kimi-code && bun run dev",
    "dev:cli:marketplace": "cd apps/kimi-code && KIMI_CODE_DEV_MARKETPLACE_URL=https://code.kimi.com/kimi-code/plugins/marketplace.json bun run dev",
    "dev:desktop": "bun run --filter kimi-code-app dev",
    "dev:desktop-canary": "KIMI_DESKTOP_CANARY=true bun run --filter kimi-code-app dev",
    "dev:desktop:debug": "bun run --filter kimi-code-app dev -- --remote-debugging-port=9222",
    "dev:docs": "cd docs && bun install && bun run dev",
    "dev:kap-server": "cd apps/kimi-code && bun run dev:kap-server",
    "dev:local": "./scripts/run-local.sh",
    "dev:local:watch": "./scripts/run-local.sh --watch",
    "dev:server": "cd apps/kimi-code && bun run dev:server",
    "dev:v2": "cd apps/kimi-code && bun run dev:server",
    "dev:web": "bun run --filter kimi-code-app dev:web",
    "e2e:desktop": "bun run --filter kimi-code-app e2e",
    "e2e:desktop:headless": "bun run --filter kimi-code-app e2e:headless",
    "gen:manifests": "cd packages/agent-core-v2 && bun run gen:config-manifest && bun run gen:wire-manifest && bun run gen:state-manifest && bun run gen:error-codes",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:pkg": "(cd apps/kimi-code && publint) && (cd apps/kimi-code && npm_config_cache=${TMPDIR:-/tmp}/kimi-code-npm-cache attw --pack . --profile node16)",
    "measure:image-tokens": "bun scripts/measure-image-tokens.cjs",
    "package:macos": "bash apps/desktop/scripts/package-local-macos.sh",
    "prepare": "simple-git-hooks",
    "publish": "bun run typecheck && bun run lint && bun run sherif && bun run test && bun run build && bun run lint:pkg && changeset publish",
    "scan:hardcoded": "bun scripts/scan-hardcoded-v2.mjs",
    "scan:residue": "bun scripts/scan-test-residue.mjs --baseline=.scan-test-residue.baseline.json",
    "scan:residue:json": "bun scripts/scan-test-residue.mjs --baseline=.scan-test-residue.baseline.json --json",
    "sherif": "sherif -i @agentclientprotocol/sdk -i vite -i fuse.js -i jsdom -i tsdown -i typescript -i diff -i @vitejs/plugin-vue -i katex -r packages-without-package-json",
    "snapshot": "bun --import ./build/register-raw-text-loader.mjs ./apps/kimi-code/src/main.ts snapshot",
    "sync:web": "bun apps/kimi-code/scripts/sync-web-dist.mjs",
    "test": "bun scripts/run-tests.mjs",
    "test:bench": "bun scripts/run-tests.mjs --script=test:bench",
    "test:coverage": "bun scripts/run-tests.mjs --coverage --coverage-reporter=lcov",
    "test:heavy": "bun scripts/run-test-heavy.mjs",
    "test:minidb": "cd packages/minidb && bun run test",
    "test:scripts": "bun scripts/run-package-tests.mjs --package=. --root=scripts/test --root=scripts/prompt-optimizer/test",
    "test:timings": "bun scripts/run-tests.mjs --timings=test-timings.jsonl",
    "test:watch": "bun scripts/run-tests.mjs --watch",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "verify": "bun scripts/verify-packages.mjs",
    "version": "changeset version",
    "version:release": "changeset version",
    "vis": "cd apps/vis && bun run dev"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@microsoft/api-extractor": "7.58.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.15.3",
    "lint-staged": "16.4.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "pkg-pr-new": "0.0.75",
    "publint": "0.3.18",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "typescript-legacy": "npm:typescript@6.0.2",
    "vite": "^6.4.3",
    "vitest": "4.1.4",
    "@vitest/coverage-v8": "4.1.4"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "@hono/node-server": ">=2.0.5",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=5.0.8",
    "diff": ">=8.0.3",
    "dompurify": ">=3.4.12",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.1",
    "find-my-way": ">=9.7.0",
    "gray-matter>js-yaml": "^3.14.1",
    "hono": ">=4.12.18",
    "ip-address": ">=10.3.1",
    "js-yaml": ">=4.2.0",
    "kimi-code>@tailwindcss/vite": "4.1.18",
    "kimi-code>tailwindcss": "4.1.18",
    "linkify-it": ">=5.0.2",
    "mermaid": ">=11.16.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.18",
    "protobufjs": ">=7.5.5",
    "qs": ">=6.15.2",
    "react-router": ">=7.15.1 <8.0.0",
    "serialize-javascript": ">=7.0.3",
    "shell-quote": ">=1.8.4",
    "tar": ">=7.5.22",
    "undici": ">=7.28.0",
    "vite": ">=6.4.3 <8.0.0",
    "ws": ">=8.21.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --type-aware --quiet"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "simple-git-hooks"
  ]
}
