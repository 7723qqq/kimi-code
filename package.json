{
  "name": "@moonshot-ai/monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "!packages/kimi-build",
      "apps/*",
      "!apps/kimi-web",
      "apps/vis/server",
      "apps/vis/web",
      "docs"
    ],
    "catalog": {
      "zod": "4.3.6",
      "pathe": "^2.0.3",
      "smol-toml": "^1.6.1",
      "jimp": "^1.6.1",
      "yazl": "^3.3.1",
      "ulid": "^3.0.1",
      "ws": "^8.18.0",
      "tsx": "^4.21.0"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "build": "bun run --workspaces build",
    "build:packages": "bun run --filter './packages/*' build",
    "dev:cli": "cd apps/kimi-code && bun run dev",
    "dev:cli:legacy": "cd apps/kimi-code && KIMI_CODE_LEGACY_FLAG=1 bun run dev",
    "dev:cli:marketplace": "cd apps/kimi-code && KIMI_CODE_DEV_MARKETPLACE_URL=https://code.kimi.com/kimi-code/plugins/marketplace.json bun run dev",
    "dev:server": "cd apps/kimi-code && bun run dev:server",
    "dev:kap-server": "cd apps/kimi-code && bun run dev:kap-server",
    "dev:v2": "cd apps/kimi-code && bun run dev:kap-server:multi",
    "build:plugin-marketplace": "cd apps/kimi-code && bun run build:plugin-marketplace",
    "vis": "cd apps/vis && bun run dev",
    "dev:docs": "cd docs && bun install && bun run dev",
    "typecheck": "bun run build:packages && bun run --filter './packages/*' typecheck && (cd apps/kimi-code && bun run typecheck) && (cd apps/vscode && bun run typecheck) && (cd apps/vis/server && bun run typecheck) && (cd apps/vis/web && bun run typecheck)",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:pkg": "(cd apps/kimi-code && publint) && (cd apps/kimi-code && npm_config_cache=${TMPDIR:-/tmp}/kimi-code-npm-cache attw --pack . --profile node16)",
    "sherif": "sherif -i @agentclientprotocol/sdk -r packages-without-package-json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "bun run --workspaces clean",
    "generate:locale-json": "npx tsx scripts/generate-locale-json.cjs",
    "check:locale-keys": "npx tsx scripts/check-locale-keys.mjs",
    "scan:hardcoded": "node scripts/scan-hardcoded-v2.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "version:release": "changeset version",
    "publish": "bun run typecheck && bun run lint && bun run sherif && bun run test && bun run build && bun run lint:pkg && changeset publish",
    "bench:prompt": "tsx scripts/prompt-optimizer/src/cli.ts bench",
    "bench:prompt:compare": "tsx scripts/prompt-optimizer/src/cli.ts bench --compare",
    "bench:prompt:prune": "tsx scripts/prompt-optimizer/src/cli.ts prune",
    "bench:prompt:probe": "tsx scripts/prompt-optimizer/src/cli.ts probe",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "4.1.10",
    "lint-staged": "16.4.0",
    "node-gyp": "11.4.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "pkg-pr-new": "0.0.75",
    "postject": "1.0.0-alpha.6",
    "publint": "0.3.18",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vite": "^6.4.3",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "simple-git-hooks",
    "ssh2"
  ],
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "concurrent": "false",
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "patchedDependencies": {
    "ssh2@1.17.0": "patches/ssh2@1.17.0.patch"
  },
  "overrides": {
    "@babel/core": ">=7.29.6",
    "@hono/node-server": ">=2.0.5",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=5.0.8",
    "diff": ">=8.0.3",
    "dompurify": ">=3.4.12",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.1",
    "find-my-way": ">=9.7.0",
    "gray-matter>js-yaml": "^3.14.1",
    "hono": ">=4.12.18",
    "ip-address": ">=10.3.1",
    "js-yaml": ">=4.2.0",
    "kimi-code>@tailwindcss/vite": "4.1.18",
    "kimi-code>tailwindcss": "4.1.18",
    "linkify-it": ">=5.0.2",
    "mermaid": ">=11.16.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.18",
    "protobufjs": ">=7.5.5",
    "qs": ">=6.15.2",
    "react-router": ">=7.15.1 <8.0.0",
    "serialize-javascript": ">=7.0.3",
    "shell-quote": ">=1.8.4",
    "tar": ">=7.5.22",
    "undici": ">=7.28.0",
    "vite": ">=6.4.3 <8.0.0",
    "ws": ">=8.21.0",
    "ssh2@1.17.0>cpu-features": "-",
    "ssh2@1.17.0>nan": "-"
  }
}
